# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Caches and test outputs
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
venv/
.venv/
env/
ENV/

# Data files (raw workbooks and processed datasets must never be committed)
data/raw/
data/interim/
data/processed/
*.xlsx
*.xls
*.csv.gz
*.parquet

# Local models and checkpoints (broad exclusion)
*.pkl
*.joblib
/models/
data/**/models/

# Allowlist: approved deployment artifact bundle only
# These exact versioned artifacts are safe to publish; raw data is never included.
!deployment_artifacts/
!deployment_artifacts/**/
!deployment_artifacts/**/*.joblib
!deployment_artifacts/**/*.json

# OS and IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Build and packaging
*.egg-info/
build/
dist/

# Temporary and scratch files
*.tmp
*.temp
scratch/
